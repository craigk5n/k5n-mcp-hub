# Environment overrides. Two patterns, both shown below:
#   - a bare var for the HTTP port (highest priority)
#   - MCPHUB_ prefix with __ separating nested keys, for anything in config.yaml
#
# Copy to .env for local use (.env is gitignored). Every value here mirrors a
# setting in config.yaml; nothing is required unless noted.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HTTP_PORT=8080
# MCPHUB_SERVER__HTTP_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Default is inmemory (nothing survives a restart). Use json to persist.
# MCPHUB_STORAGE__TYPE=json
# MCPHUB_STORAGE__JSON__PATH=/data/mcp_servers.json

# ---------------------------------------------------------------------------
# Authentication — none (default) | basic | jwt
# ---------------------------------------------------------------------------
# basic: protects the write and admin routes. The hub refuses to start without
# a password rather than running with "protection" that isn't there.
# MCPHUB_AUTH__TYPE=basic
# MCPHUB_AUTH__BASIC_AUTH__REGISTER_PASS=changeme

# jwt: the hub becomes an OAuth 2.1 resource server, validating inbound access
# tokens against your IdP's JWKS. Required for on-behalf-of. All three below are
# required together — the hub names the missing one at startup and refuses to run.
# Walkthrough: docs/operator-guide-obo.md
# MCPHUB_AUTH__TYPE=jwt
# MCPHUB_AUTH__JWT__ISSUER=https://idp.example.com/realms/mcp-hub
# MCPHUB_AUTH__JWT__AUDIENCE=k5n-mcp-hub
# MCPHUB_AUTH__JWT__JWKS_URI=https://idp.example.com/realms/mcp-hub/protocol/openid-connect/certs
#
# Optional: clock-skew tolerance, and the hub's public identity when it sits
# behind a reverse proxy (RFC 9728 metadata is derived from the request URL
# otherwise).
# MCPHUB_AUTH__JWT__LEEWAY_SECONDS=30
# MCPHUB_AUTH__JWT__RESOURCE=https://hub.example.com

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Permit reaching MCP servers on localhost/LAN. Off by default; the repo's own
# config.yaml turns it on for local-first use, and `k5n-mcp-hub --dev` sets it
# for an installed CLI. Keep it false anywhere untrusted callers can reach the hub.
# MCPHUB_SECURITY__ALLOW_PRIVATE_NETWORKS=true

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------
# MCPHUB_TRACE__BODY_LIMIT=10000
# MCPHUB_TRACE__CAPTURE_SSE=false
