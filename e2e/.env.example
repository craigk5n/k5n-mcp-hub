# Credentials for the throwaway e2e Keycloak. Copy to `.env` and change the values
# to override the defaults baked into docker-compose.obo.yml:
#
#   cp e2e/.env.example e2e/.env
#
# `.env` is gitignored. These are not production secrets and never should be: the
# realm they configure exists only while the compose stack is up. They live here
# rather than in realm-mcp-hub.json so that the committed realm file carries no
# credential-shaped strings at all -- Keycloak substitutes the ${...} placeholders
# at import time.
KC_HUB_CLIENT_SECRET=dev-only-hub-secret
KC_ALICE_PASSWORD=dev-only-alice-password
KC_BOB_PASSWORD=dev-only-bob-password
