# Credentials for the throwaway e2e Keycloak. REQUIRED -- the stack will not start
# without them:
#
#   cp e2e/.env.example e2e/.env
#
# Docker Compose reads `.env` from the directory holding the compose file, so
# e2e/.env is picked up even when you run from the repo root. `.env` is gitignored.
#
# There are deliberately no defaults. A fallback would let the realm be built with
# values nobody chose, and any mismatch would surface later as an authentication
# failure that looks like a broken token exchange rather than missing configuration.
#
# These are not production secrets and never should be: the realm they configure
# exists only while the compose stack is up. They live here rather than in
# realm-mcp-hub.json so the committed realm file carries no credential-shaped
# strings -- Keycloak substitutes the ${...} placeholders at import time.
KC_HUB_CLIENT_SECRET=dev-only-hub-secret
KC_ALICE_PASSWORD=dev-only-alice-password
KC_BOB_PASSWORD=dev-only-bob-password
