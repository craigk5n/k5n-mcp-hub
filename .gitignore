__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
.env
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime agent-fixture store written by the app/tests at repo root
/.mcp_hub/

# JSON storage backend file (default path). Contains registered servers including
# plaintext bearer tokens / basic-auth passwords — must never be committed.
# The glob covers copies and backups of it (mcp_servers.json.bak, .old, .1, ...),
# which hold exactly the same credentials as the original.
/mcp_servers.json*

# Editor and tooling backups anywhere in the tree, for the same reason: a .bak of a
# credential-bearing file is still credential-bearing.
*.bak

# Local dev launcher. Kept working as the CLI changes, but deliberately not part of
# the repo — it encodes one developer's ports and paths, not the project's.
/run.sh

# Local-only audit (not tracked)
AUDIT_local.md
