{%- set is_hub_bool = is_hub in ('True', 'true', '1') or is_hub == true -%}
{%- set is_streamable_bool = is_streamable in ('True', 'true', '1') or is_streamable == true -%}
#!/usr/bin/env python3
"""MCP tool invocation script (direct or via k5n-mcp-hub).
{% if is_streamable_bool %}Uses direct HTTP for streamable servers (no SDK required).{% else %}Requires: mcp (Python SDK). Install: pip install mcp{% endif %}
"""
import asyncio
import base64
import getpass
import json
import os
import ssl
import sys
from typing import Optional

{% if is_streamable_bool %}
import httpx
{% endif %}


PROTOCOL_VERSION = {{ protocol_version | tojson }}
IS_STREAMABLE = {% if is_streamable_bool %}True{% else %}False{% endif %}
IS_HUB = {% if is_hub_bool %}True{% else %}False{% endif %}
BASE_URL = {{ base_url | tojson }}
AUTH_HEADER_ENV = {{ auth_header_value | tojson }}
TARGET_SERVER = {% if is_hub_bool %}{{ target_server_id | tojson }}{% else %}None{% endif %}
CA_BUNDLE_PATH = {{ ca_bundle | tojson }}
TOOL_NAME = {{ tool_name | tojson }}
INIT_BODY = json.loads({{ init_body | tojson }})
CALL_BODY = json.loads({{ call_body | tojson }})


def get_auth_header() -> Optional[str]:
    if AUTH_HEADER_ENV:
        return os.environ.get(AUTH_HEADER_ENV, "")
    return None


def prompt_mcp_hub_basic_auth() -> Optional[str]:
    username = input("k5n-mcp-hub Username: ")
    password = getpass.getpass("k5n-mcp-hub Password: ")
    b64 = base64.b64encode(f"{username}:{password}".encode()).decode()
    return f"Basic {b64}"


{% if is_streamable_bool %}
def build_headers(auth_header: Optional[str], target_server: Optional[str]) -> dict[str, str]:
    headers: dict[str, str] = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "MCP-Protocol-Version": PROTOCOL_VERSION,
    }
    if auth_header:
        headers["Authorization"] = auth_header
    if target_server:
        headers["X-MCP-Target-Server"] = target_server
    return headers


def parse_sse_body(response: httpx.Response) -> str:
    content_type = response.headers.get("Content-Type", "")
    if "text/event-stream" in content_type:
        for line in response.text.split("\n"):
            if line.startswith("data: "):
                data = line[6:]
                if data and data != "[DONE]":
                    return data
    return response.text


async def http_request(
    client: httpx.AsyncClient,
    url: str,
    body: dict,
    headers: dict[str, str],
) -> httpx.Response:
    return await client.post(url, content=json.dumps(body).encode(), headers=headers)
{% endif %}


{% if is_streamable_bool %}
async def run_streamable() -> None:
    mcp_hub_auth: Optional[str] = None

    auth_val = get_auth_header()
    headers = build_headers(
        f"Bearer {auth_val}" if auth_val else None,
        TARGET_SERVER,
    )

    ssl_ctx: Optional[ssl.SSLContext] = None
    if CA_BUNDLE_PATH:
        ssl_ctx = ssl.create_default_context(cafile=CA_BUNDLE_PATH)

    async with httpx.AsyncClient(verify=ssl_ctx if ssl_ctx else True) as client:
        print("Initializing MCP session...", file=sys.stderr)
        resp = await http_request(client, BASE_URL, INIT_BODY, headers)
        if resp.status_code == 401:
            if mcp_hub_auth is None:
                mcp_hub_auth = prompt_mcp_hub_basic_auth()
                headers = build_headers(mcp_hub_auth, TARGET_SERVER)
                resp = await http_request(client, BASE_URL, INIT_BODY, headers)
                if resp.status_code == 401:
                    print("Unauthorized", file=sys.stderr)
                    print(resp.text)
                    sys.exit(1)

        init_data = json.loads(parse_sse_body(resp))
        session_id = init_data.get("result", {}).get("sessionId", "")
        if session_id:
            headers["Mcp-Session-Id"] = session_id
            print(f"Session ID: {session_id}", file=sys.stderr)

        inited_body = {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}}
        print("Sending MCP initialized notification...", file=sys.stderr)
        await http_request(client, BASE_URL, inited_body, headers)

        print(f"Calling tool: {TOOL_NAME}...", file=sys.stderr)
        resp = await http_request(client, BASE_URL, CALL_BODY, headers)
        if resp.status_code == 401:
            if mcp_hub_auth is None:
                mcp_hub_auth = prompt_mcp_hub_basic_auth()
                headers = build_headers(mcp_hub_auth, TARGET_SERVER)
                if session_id:
                    headers["Mcp-Session-Id"] = session_id
                resp = await http_request(client, BASE_URL, CALL_BODY, headers)
        if resp.status_code == 401:
            print("Unauthorized", file=sys.stderr)
            print(resp.text)
            sys.exit(1)

        result = parse_sse_body(resp)
        print(result)
{% endif %}


async def run_via_sdk() -> None:
{% if not is_streamable_bool %}
    from mcp.client.session import ClientSession
    from mcp.client.stdio import StdioClient

    async with StdioClient() as client:
        async with ClientSession(client) as session:
            await session.initialize()
            result = await session.call_tool(TOOL_NAME)
            print(json.dumps(result))
{% else %}
    pass  # Not applicable for streamable transports
{% endif %}

async def main() -> None:
    if IS_STREAMABLE:
        await run_streamable()
    else:
        await run_via_sdk()


if __name__ == "__main__":
    asyncio.run(main())
