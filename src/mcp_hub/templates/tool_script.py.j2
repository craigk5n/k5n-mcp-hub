{%- set is_hub_bool = is_hub in ('True', 'true', '1') or is_hub == true -%}
{%- set stateless_bool = is_stateless | default('false') in ('True', 'true', '1') -%}
#!/usr/bin/env python3
{% if stateless_bool -%}
"""MCP tool invocation script generated by k5n-mcp-hub.

Calls an MCP tool via the stateless protocol revision (2026-07-28): one
self-contained tools/call POST -- no handshake, no session. Uses only httpx,
no MCP SDK required, works on Python 3.8+. Credentials are read from
environment variables (never embedded); you are prompted if they are missing.

Requires: httpx   (pip3 install httpx)
"""
{%- else -%}
"""MCP tool invocation script generated by k5n-mcp-hub.

Calls an MCP tool over streamable HTTP (initialize -> initialized -> tools/call)
using only httpx -- no MCP SDK required, works on Python 3.8+. Credentials are read
from environment variables (never embedded); you are prompted if they are missing.

Requires: httpx   (pip3 install httpx)
"""
{%- endif %}
import asyncio
import base64
import getpass
import json
import os
import ssl
import sys
from typing import Optional

import httpx

PROTOCOL_VERSION = {{ protocol_version | tojson }}
IS_HUB = {% if is_hub_bool %}True{% else %}False{% endif %}
BASE_URL = {{ base_url | tojson }}
AUTH_TYPE = {{ auth_type | default('') | tojson }}
{% if auth_type == 'obo' %}
# This server uses on-behalf-of auth, so calls must go through the hub: pointed
# straight at the backend, your token has the wrong audience and will be refused.
# Set MCP_USER_TOKEN to your own access token before running.
{% endif %}
BASIC_USER_DEFAULT = {{ basic_username | default('') | tojson }}
TARGET_SERVER = {% if is_hub_bool %}{{ target_server_id | tojson }}{% else %}None{% endif %}
CA_BUNDLE_PATH = {{ ca_bundle | tojson }}
TOOL_NAME = {{ tool_name | tojson }}
INIT_BODY = json.loads({{ init_body | tojson }})
CALL_BODY = json.loads({{ call_body | tojson }})
INITED_BODY = {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}}


def build_auth_header():
    """Build the Authorization header from environment variables (prompting if absent)."""
    if IS_HUB:
        # Hub mode: authenticate to k5n-mcp-hub; the hub applies the target server's auth.
        user = os.environ.get("MCPHUB_USER") or input("k5n-mcp-hub Username: ")
        pw = os.environ.get("MCPHUB_PASS") or getpass.getpass("k5n-mcp-hub Password: ")
        return "Basic " + base64.b64encode("{0}:{1}".format(user, pw).encode()).decode()
    if AUTH_TYPE == "bearer":
        token = os.environ.get("MCP_BEARER_TOKEN") or getpass.getpass("Bearer token: ")
        return "Bearer " + token
    if AUTH_TYPE == "basic":
        user = os.environ.get("MCP_BASIC_USER") or BASIC_USER_DEFAULT or input("Username: ")
        pw = os.environ.get("MCP_BASIC_PASS") or getpass.getpass(
            "Password / application password for {0}: ".format(user)
        )
        return "Basic " + base64.b64encode("{0}:{1}".format(user, pw).encode()).decode()
    if AUTH_TYPE == "oauth":
        token = os.environ.get("MCP_ACCESS_TOKEN") or getpass.getpass("OAuth access token: ")
        return "Bearer " + token
{% if auth_type == 'obo' %}
    if AUTH_TYPE == "obo":
        # On-behalf-of: this is YOUR access token, not the server's. The hub validates
        # it and exchanges it (RFC 8693) for one whose audience is the target server.
        # Nothing reusable can be baked into this script -- the credential is yours and
        # expires with your session.
        token = os.environ.get("MCP_USER_TOKEN") or getpass.getpass("Your access token: ")
        return "Bearer " + token
{% endif %}
    return None


def build_headers(auth_header, session_id):
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "MCP-Protocol-Version": PROTOCOL_VERSION,
    }
{% if stateless_bool %}
    headers["Mcp-Method"] = "tools/call"
{% endif %}
    if auth_header:
        headers["Authorization"] = auth_header
    if TARGET_SERVER:
        headers["X-MCP-Target-Server"] = TARGET_SERVER
    if session_id:
        headers["Mcp-Session-Id"] = session_id
    return headers


def parse_body(resp):
    """Return the JSON payload; if the response is SSE, use its first data: line."""
    if "text/event-stream" in resp.headers.get("Content-Type", ""):
        for line in resp.text.split("\n"):
            line = line.rstrip("\r")
            if line.startswith("data:"):
                data = line[5:].strip()
                if data and data != "[DONE]":
                    return data
    return resp.text


def check_error(phase, resp, body):
    """Exit on an HTTP auth status or a JSON-RPC {"error": {...}} (some servers return
    HTTP 200 with such an error, e.g. WordPress auth failures)."""
    if resp.status_code in (401, 403):
        print(
            "Error during {0}: HTTP {1} (authentication failed).".format(phase, resp.status_code),
            file=sys.stderr,
        )
        print(body, file=sys.stderr)
        sys.exit(1)
    try:
        parsed = json.loads(body)
    except (ValueError, TypeError):
        parsed = None
    if isinstance(parsed, dict) and isinstance(parsed.get("error"), dict):
        print("Error during {0}:".format(phase), file=sys.stderr)
        print(body, file=sys.stderr)
        sys.exit(1)


async def main() -> None:
    auth_header = build_auth_header()
    session_id = ""
    verify = ssl.create_default_context(cafile=CA_BUNDLE_PATH) if CA_BUNDLE_PATH else True

    async with httpx.AsyncClient(verify=verify, timeout=60.0) as client:
{% if not stateless_bool %}
        print("Initializing MCP session...", file=sys.stderr)
        resp = await client.post(
            BASE_URL, content=json.dumps(INIT_BODY).encode(), headers=build_headers(auth_header, session_id)
        )
        body = parse_body(resp)
        check_error("initialize", resp, body)
        session_id = resp.headers.get("Mcp-Session-Id", "") or session_id

        print("Sending MCP initialized notification...", file=sys.stderr)
        await client.post(
            BASE_URL,
            content=json.dumps(INITED_BODY).encode(),
            headers=build_headers(auth_header, session_id),
        )

{% endif %}
        print("Calling tool: {0}...".format(TOOL_NAME), file=sys.stderr)
        resp = await client.post(
            BASE_URL, content=json.dumps(CALL_BODY).encode(), headers=build_headers(auth_header, session_id)
        )
        body = parse_body(resp)
        check_error("tools/call", resp, body)

        # Tool output on stdout so it can be piped (e.g. | python3 -m json.tool).
        print(body)


if __name__ == "__main__":
    asyncio.run(main())
