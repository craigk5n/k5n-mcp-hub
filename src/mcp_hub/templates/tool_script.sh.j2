#!/usr/bin/env bash
# Generated by k5n-mcp-hub. Calls an MCP tool via the streamable-HTTP protocol
# (initialize -> initialized -> tools/call). Credentials are read from environment
# variables (never embedded); you are prompted if they are missing.
set -uo pipefail

BASE_URL='{{ base_url | replace("'", "'\\''") }}'
INIT_BODY='{{ init_body | replace("'", "'\\''") }}'
CALL_BODY='{{ call_body | replace("'", "'\\''") }}'
INITED_BODY='{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}'
PROTOCOL_VERSION='{{ protocol_version | replace("'", "'\\''") }}'
TOOL_NAME='{{ tool_name | replace("'", "'\\''") }}'
AUTH_TYPE='{{ auth_type | replace("'", "'\\''") }}'
BASIC_USER_DEFAULT='{{ basic_username | replace("'", "'\\''") }}'
TARGET_SERVER_ID='{{ target_server_id | replace("'", "'\\''") }}'
CA_BUNDLE_PATH='{{ ca_bundle | replace("'", "'\\''") }}'

MCP_SESSION_ID=""
AUTH_HEADER=""

# Build the Authorization header once, from environment variables (prompting if absent).
build_auth_header() {
{% if is_hub and (is_hub == 'True' or is_hub == 'true' or is_hub == '1') %}
    # Hub mode: authenticate to k5n-mcp-hub; the hub applies the target server's own auth.
    if [[ -z "${MCPHUB_USER:-}" || -z "${MCPHUB_PASS:-}" ]]; then
        read -r -p "k5n-mcp-hub Username: " MCPHUB_USER
        read -r -s -p "k5n-mcp-hub Password: " MCPHUB_PASS; echo >&2
    fi
    AUTH_HEADER="Authorization: Basic $(printf '%s:%s' "$MCPHUB_USER" "$MCPHUB_PASS" | base64 | tr -d '\n')"
{% else %}
    case "$AUTH_TYPE" in
        bearer)
            if [[ -z "${MCP_BEARER_TOKEN:-}" ]]; then
                read -r -s -p "Bearer token: " MCP_BEARER_TOKEN; echo >&2
            fi
            AUTH_HEADER="Authorization: Bearer ${MCP_BEARER_TOKEN}"
            ;;
        basic)
            local basic_user="${MCP_BASIC_USER:-$BASIC_USER_DEFAULT}"
            if [[ -z "$basic_user" ]]; then
                read -r -p "Username: " basic_user
            fi
            if [[ -z "${MCP_BASIC_PASS:-}" ]]; then
                read -r -s -p "Password / application password for ${basic_user}: " MCP_BASIC_PASS; echo >&2
            fi
            AUTH_HEADER="Authorization: Basic $(printf '%s:%s' "$basic_user" "$MCP_BASIC_PASS" | base64 | tr -d '\n')"
            ;;
        oauth)
            if [[ -z "${MCP_ACCESS_TOKEN:-}" ]]; then
                read -r -s -p "OAuth access token: " MCP_ACCESS_TOKEN; echo >&2
            fi
            AUTH_HEADER="Authorization: Bearer ${MCP_ACCESS_TOKEN}"
            ;;
        *)
            AUTH_HEADER=""
            ;;
    esac
{% endif %}
}

RESP_STATUS=""
RESP_BODY=""

# POST a JSON-RPC message; sets RESP_STATUS and RESP_BODY. Handles the streamable-HTTP
# session id (response header) and SSE responses (first data: line is the JSON payload).
mcp_call() {
    local body="$1"
    local headers_file body_file http_code
    headers_file=$(mktemp)
    body_file=$(mktemp)

    local curl_args=(-sS -X POST
        -H "Content-Type: application/json"
        -H "Accept: application/json, text/event-stream"
        -H "MCP-Protocol-Version: $PROTOCOL_VERSION")
    [[ -n "$AUTH_HEADER" ]] && curl_args+=(-H "$AUTH_HEADER")
    [[ -n "$MCP_SESSION_ID" ]] && curl_args+=(-H "Mcp-Session-Id: $MCP_SESSION_ID")
{% if is_hub and (is_hub == 'True' or is_hub == 'true' or is_hub == '1') %}
    curl_args+=(-H "X-MCP-Target-Server: $TARGET_SERVER_ID")
{% endif %}
{% if ca_bundle %}
    curl_args+=(--cacert "$CA_BUNDLE_PATH")
{% endif %}
    curl_args+=(--max-time 60 -d "$body")

    http_code=$(curl "${curl_args[@]}" -D "$headers_file" -o "$body_file" -w '%{http_code}' "$BASE_URL")
    RESP_STATUS="$http_code"

    local sid
    sid=$(grep -i '^mcp-session-id:' "$headers_file" | head -1 | tr -d '\r' | sed 's/^[^:]*:[[:space:]]*//')
    [[ -n "$sid" ]] && MCP_SESSION_ID="$sid"

    local ctype
    ctype=$(grep -i '^content-type:' "$headers_file" | head -1 | tr -d '\r' | sed 's/^[^:]*:[[:space:]]*//')
    if [[ "$ctype" == text/event-stream* ]]; then
        local data
        data=$(grep '^data:' "$body_file" | head -1 | sed 's/^data:[[:space:]]*//' | tr -d '\r')
        [[ -n "$data" ]] && printf '%s' "$data" > "$body_file"
    fi

    RESP_BODY=$(cat "$body_file")
    rm -f "$headers_file" "$body_file"
}

# Fail loudly on an HTTP auth status or a JSON-RPC protocol error (some servers, e.g.
# WordPress, return HTTP 200 with an {"error":{...}} auth message).
check_error() {
    local phase="$1"
    if [[ "$RESP_STATUS" == "401" || "$RESP_STATUS" == "403" ]]; then
        echo "Error during ${phase}: HTTP ${RESP_STATUS} (authentication failed)." >&2
        echo "$RESP_BODY" >&2
        exit 1
    fi
    if printf '%s' "$RESP_BODY" | grep -qE '"error"[[:space:]]*:[[:space:]]*\{'; then
        echo "Error during ${phase}:" >&2
        echo "$RESP_BODY" >&2
        exit 1
    fi
}

build_auth_header

echo "Initializing MCP session..." >&2
mcp_call "$INIT_BODY"
check_error "initialize"

echo "Sending MCP initialized notification..." >&2
mcp_call "$INITED_BODY"

echo "Calling tool: ${TOOL_NAME}..." >&2
mcp_call "$CALL_BODY"
check_error "tools/call"

# Tool output on stdout so it can be piped (e.g. | jq).
printf '%s\n' "$RESP_BODY"
